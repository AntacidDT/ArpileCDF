# Place PrBoom static data/BSS in external PSRAM (only when PSRAM ext-BSS is
# available); falls back to default DRAM placement otherwise.
[scheme:prboom_psram]
entries:
    if APP_BUILD_USE_FLASH_SECTIONS = y:
        text -> flash_text
        rodata -> flash_rodata
    else:
        text -> iram0_text
        rodata -> dram0_data
    if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        bss -> extern_ram
        common -> extern_ram
        legacy_bss -> extern_ram

[mapping:prboom]
archive: libprboom.a
entries:
    * (prboom_psram)
